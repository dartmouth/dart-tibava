# --- Stage 1: Build the Vue application ---
FROM node:16-bullseye AS builder

WORKDIR /app/frontend

# Cache npm install separately from source copy
COPY frontend/package.json frontend/package-lock.json* /app/frontend/
RUN npm install

COPY frontend/ /app/frontend/

# Vue CLI inlines app.config.js into the built JS bundle at compile time, so
# the backend/thumbnail locations must be correct *before* `npm run build`
# runs, not injected afterwards. The committed frontend/app.config.js
# hardcodes http://localhost:8000, which only works for local docker-compose
# (where the browser reaches the backend container via a published port on
# the host). The k8s Deployment instead runs frontend and backend as
# containers in the same Pod behind a single Service/LoadBalancer that only
# exposes the frontend's port 80, so the browser must call the backend
# same-origin through the frontend's nginx reverse proxy (see
# frontend/default.conf's /backend/ location) rather than a separate host.
# These ARGs default to that same-origin/relative deployment shape and can
# be overridden at build time (e.g. --build-arg API_LOCATION=http://host:8000)
# for other deployment topologies.
ARG API_LOCATION=/backend
ARG THUMBNAIL_LOCATION=/thumbnails
RUN printf 'module.exports = {\n  API_LOCATION: "%s",\n  THUMBNAIL_LOCATION: "%s",\n};\n' \
      "${API_LOCATION}" "${THUMBNAIL_LOCATION}" > /app/frontend/app.config.js

RUN npm run build

# --- Stage 2: Serve the built app with nginx ---
# Pinned to a maintained nginx/Alpine tag; 1.21.0-alpine bundles Alpine 3.13.5
# (EOL, unpatched CRITICAL CVEs in apk-tools/curl/openssl1.1/zlib/freetype).
FROM nginx:1.27-alpine

# Upgrade Alpine packages to pick up patched CVE fixes (e.g. libcrypto3/libssl3)
# that land after this base image tag was published, since the tag itself is
# a fixed snapshot and doesn't get security patches in place.
RUN apk update && apk upgrade --no-cache && apk add --no-cache curl

COPY frontend/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/frontend/dist/ /app/frontend/dist/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
